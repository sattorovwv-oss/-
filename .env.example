# Copy to .env. Never commit real passwords or BOT_TOKEN.
APP_ENV=development
BOT_TOKEN=
PUBLIC_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000
DB_PATH=var/tuman.db
# WEB_ONLY=1 explicitly disables Telegram polling/delivery for local development.
WEB_ONLY=0
# Initial admin accounts. At least 12 characters; no built-in passwords.
# These only create missing accounts. Change existing passwords in Settings.
OWNER_PASSWORD=
CHINA_PASSWORD=
TAJIK_PASSWORD=
# Numeric Telegram user IDs, comma-separated. Obtain your ID with /id in the bot.
OWNER_TELEGRAM_IDS=
CHINA_TELEGRAM_IDS=
TAJIK_TELEGRAM_IDS=
# Optional customer sign-in with Google. Configure both values to show the button.
# Register PUBLIC_URL + /auth/google/callback in Google Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
